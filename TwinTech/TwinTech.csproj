<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <RootNamespace>Twinsanity</RootNamespace>
    <AssemblyName>TwinTech</AssemblyName>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>11</LangVersion>
    <Title>TwinTech</Title>
    <Authors>Neo_Kesha, Smartkin</Authors>
    <Description>Crash Twinsanity Toolbox to read and write its resources</Description>
    <!-- TT Lab is published as a single file, where assemblies have no location -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpHash" Version="1.2.0" />
  </ItemGroup>

  <!-- Read by their file names through Libraries/EmbeddedFiles, programs using TwinTech need nothing next to them -->
  <ItemGroup>
    <None Remove="AgentLabDefsPS2.json;AgentLabDefsXbox.json;TextureDescriptionHelper.json;AgentLab\*.lab" />
    <EmbeddedResource Include="AgentLabDefsPS2.json;AgentLabDefsXbox.json;TextureDescriptionHelper.json;AgentLab\*.lab" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>