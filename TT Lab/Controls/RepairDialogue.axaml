<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="220"
        x:Class="TT_Lab.Controls.RepairDialogue"
        x:DataType="x:String"
        Title="Repair the game's packages"
        MinHeight="160" MaxWidth="720" SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterOwner">
    <controls:GroupBox>
        <Grid RowDefinitions="*,Auto">
            <TextBlock Grid.Row="0" Text="{Binding}" TextWrapping="Wrap" Margin="10" VerticalAlignment="Center"/>
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" MaxWidth="460">
                <Button x:Name="RepairButton" Content="Repair" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5" Padding="3" IsDefault="True" Click="RepairButton_OnClick"/>
                <Button x:Name="NotNowButton" Grid.Column="1" Content="Not Now" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5" Padding="3" IsCancel="True" Click="NotNowButton_OnClick"/>
                <Button x:Name="DontAskAgainButton" Grid.Column="2" Content="Don't Ask Again" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5" Padding="3" Click="DontAskAgainButton_OnClick"/>
            </Grid>
        </Grid>
    </controls:GroupBox>
</Window>
