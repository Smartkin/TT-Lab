<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TT_Lab.ViewModels"
             x:DataType="viewModels:HistoryViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             Focusable="True"
             x:Class="TT_Lab.Views.HistoryView">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z"/>
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Y"/>
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Shift+Z"/>
    </UserControl.KeyBindings>
    <UserControl.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.tool:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
    </UserControl.Styles>
    <Grid>
        <TextBlock Text="Work in an editor to see what it changed, every editor keeps its own history" TextWrapping="Wrap" Margin="10" Opacity="0.7"
                   IsVisible="{Binding Document, Converter={x:Static ObjectConverters.IsNull}}"/>
        <DockPanel IsVisible="{Binding Document, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="4,2">
                <Button x:Name="Undo" Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)">
                    <PathIcon Data="M2,9 L9,2.5 L9,7.5 L14,7.5 A7,7 0 0 1 14,21.5 L10,21.5 L10,18.5 L14,18.5 A4,4 0 0 0 14,10.5 L9,10.5 L9,15.5 Z"/>
                </Button>
                <Button x:Name="Redo" Classes="tool" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y or Ctrl+Shift+Z)">
                    <PathIcon Data="M22,9 L15,2.5 L15,7.5 L10,7.5 A7,7 0 0 0 10,21.5 L14,21.5 L14,18.5 L10,18.5 A4,4 0 0 1 10,10.5 L15,10.5 L15,15.5 Z"/>
                </Button>
            </StackPanel>
            <ListBox x:Name="EntriesList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:HistoryEntry">
                        <DockPanel Opacity="{Binding Opacity}" ToolTip.Tip="{Binding Tip}" Background="Transparent">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Opacity="0.6" Margin="10, 0, 0, 0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="saved" Opacity="0.6" Margin="10, 0, 0, 0" VerticalAlignment="Center" FontStyle="Italic"
                                       IsVisible="{Binding IsSaved}"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Marker}" Width="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Description}" Margin="{Binding Indent, Converter={x:Static viewModels:HistoryViewModel.IndentConverter}}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
