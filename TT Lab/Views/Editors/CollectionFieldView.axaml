<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editors="clr-namespace:TT_Lab.ViewModels.Editors"
             x:DataType="editors:CollectionFieldViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TT_Lab.Views.Editors.CollectionFieldView">
    <Expander HorizontalAlignment="Stretch">
        <Expander.Header>
            <TextBlock Text="{Binding Caption}"/>
        </Expander.Header>
        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DockPanel LastChildFill="True">
                <ItemsRepeater DockPanel.Dock="Top" x:Name="EditorsContainer">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="5" Orientation="Vertical"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate DataType="editors:DocumentPartViewModel">
                            <DockPanel Margin="10" HorizontalSpacing="15" LastChildFill="True" Background="Transparent" ToolTip.Tip="{Binding Hint}">
                                <TextBlock DockPanel.Dock="{Binding Orientation}" VerticalAlignment="Center" Text="{Binding Caption}"/>
                                <ContentControl DockPanel.Dock="{Binding EditorOrientation}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Content="{Binding}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </DockPanel>
        </ScrollViewer>
    </Expander>
</UserControl>
