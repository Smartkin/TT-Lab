<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:TT_Lab.ViewModels.Editors"
             xmlns:controls="clr-namespace:TT_Lab.Controls"
             x:DataType="viewmodels:TextFieldViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TT_Lab.Views.Editors.TextFieldView">
    <DockPanel>
        <controls:ErrorSign x:Name="TextFieldError" DockPanel.Dock="Right"/>
        <TextBox x:Name="TextField"/>
    </DockPanel>
</UserControl>
