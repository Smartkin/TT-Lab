<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:TT_Lab.ViewModels.Editors"
             x:DataType="viewmodels:LightColorFieldViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="30"
             x:Class="TT_Lab.Views.Editors.LightColorFieldView">
    <DockPanel>
        <ColorPicker x:Name="Picker" DockPanel.Dock="Left" IsAlphaEnabled="False" IsAlphaVisible="False"
                     ToolTip.Tip="The light's hue at full brightness, its brightness is in the intensity"/>
        <TextBlock x:Name="Stored" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"
                   ToolTip.Tip="Red, green and blue as the game has them, adding up to what they did (1 in the game's lights)"/>
    </DockPanel>
</UserControl>
