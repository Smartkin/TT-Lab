<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editors="clr-namespace:TT_Lab.ViewModels.Editors"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="30"
             x:Class="TT_Lab.Views.Editors.SampleRateFieldView">
    <ComboBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="RateChoices">
        <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="editors:SampleRateChoice">
                <TextBlock Text="{Binding Label}"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
