<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:TT_Lab.ViewModels.Editors"
             x:DataType="viewmodels:Vector4FieldViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TT_Lab.Views.Editors.Vector4FieldView">
    <UniformGrid Columns="4">
        <ContentControl Content="{Binding X}"/>
        <ContentControl Content="{Binding Y}"/>
        <ContentControl Content="{Binding Z}"/>
        <ContentControl Content="{Binding W}"/>
    </UniformGrid>
</UserControl>
