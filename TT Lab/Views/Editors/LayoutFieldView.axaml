<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:instance="clr-namespace:TT_Lab.Assets.Instance"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TT_Lab.Views.Editors.LayoutFieldView">
    <ComboBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" PlaceholderText="None" x:Name="LayoutChoices">
        <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="instance:ChunkLayout">
                <TextBlock ToolTip.Tip="{Binding Description}">
                    <Run Text="{Binding Id}" FontWeight="SemiBold"/>
                    <Run Text="{Binding Name}"/>
                </TextBlock>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
