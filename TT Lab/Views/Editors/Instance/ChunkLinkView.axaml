<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TT_Lab.ViewModels.Editors.Instance"
             xmlns:controls="clr-namespace:TT_Lab.Controls"
             x:DataType="viewModels:ChunkLinkViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TT_Lab.Views.Editors.Instance.ChunkLinkView">
    <controls:EditableListBox ListBoxName="Links" Items="{Binding Links}"
       AddItemCommand="{Binding AddLinkCommand}"
       RemoveItemCommand="{Binding DeleteLinkCommand}">
        <Interaction.Behaviors>
            <EventTriggerBehavior EventName="SelectedItemChanged">
                <InvokeCommandAction Command="{Binding SelectedLinkChanged}" PassEventArgsToCommand="True"/>
            </EventTriggerBehavior>
        </Interaction.Behaviors>
    </controls:EditableListBox>
</UserControl>
