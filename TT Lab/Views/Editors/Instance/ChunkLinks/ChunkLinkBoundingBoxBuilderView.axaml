<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TT_Lab.ViewModels.Editors.Instance.ChunkLinks"
             xmlns:composite="clr-namespace:TT_Lab.Views.Composite"
             xmlns:controls1="clr-namespace:TT_Lab.Controls"
             x:DataType="viewModels:ChunkLinkBoundingBoxBuilderViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TT_Lab.Views.Editors.Instance.ChunkLinks.ChunkLinkBoundingBoxBuilderView">
    <StackPanel>
        <controls1:LabeledTextBox LayoutOrientation="Horizontal" TextBoxName="Type" Text="{Binding Type}"/>
        <composite:BoundingBoxBuilderView DataContext="{Binding BoundingBoxBuilder}"/>
    </StackPanel>
</UserControl>
