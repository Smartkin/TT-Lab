<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:instance="clr-namespace:TT_Lab.ViewModels.Editors.Instance"
             x:DataType="instance:DefaultParticleSystemFieldViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="60"
             x:Class="TT_Lab.Views.Editors.Instance.DefaultParticleSystemFieldView">
    <DockPanel>
        <Button x:Name="GoToSystem" DockPanel.Dock="Right" Content="->" Margin="2,0,0,0" VerticalAlignment="Stretch"
                IsEnabled="{Binding HasSystem}" ToolTip.Tip="Show the particle system in the default chunk"/>
        <Button x:Name="Browse" DockPanel.Dock="Right" Content="..." Margin="2,0,0,0" VerticalAlignment="Stretch"
                ToolTip.Tip="Pick one of the default chunk's particle systems">
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <DockPanel Width="300" Height="360">
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Watermark="Search" Text="{Binding Search}" Margin="0,0,0,4"/>
                        <ListBox x:Name="Choices" ItemsSource="{Binding ShownChoices}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="instance:DefaultParticleSystemChoice">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding LinkState}" FontSize="11" TextWrapping="Wrap"
                   Opacity="0.7" Classes.broken="{Binding IsLinkBroken}">
            <TextBlock.Styles>
                <Style Selector="TextBlock.broken">
                    <Setter Property="Foreground" Value="OrangeRed"/>
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </TextBlock.Styles>
        </TextBlock>
        <TextBlock Text="{Binding SystemName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
</UserControl>
