<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:TT_Lab.ViewModels.Editors"
             x:DataType="viewmodels:TaggedPropertyFieldViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="30"
             x:Class="TT_Lab.Views.Editors.TaggedPropertyFieldView">
    <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="?" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip.Tip="An int as it is, Float(x), Angle(x) in degrees, Prop(index) for an instance property, Raw(0x...) for the word. A plain number keeps the value's type"/>
        <TextBox x:Name="ValueField"/>
    </DockPanel>
</UserControl>
