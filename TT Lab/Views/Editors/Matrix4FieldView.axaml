<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:TT_Lab.ViewModels.Editors"
             x:DataType="viewmodels:Matrix4FieldViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TT_Lab.Views.Editors.Matrix4FieldView">
    <UniformGrid Rows="4">
        <ContentControl Content="{Binding V1}"/>
        <ContentControl Content="{Binding V2}"/>
        <ContentControl Content="{Binding V3}"/>
        <ContentControl Content="{Binding V4}"/>
    </UniformGrid>
</UserControl>
