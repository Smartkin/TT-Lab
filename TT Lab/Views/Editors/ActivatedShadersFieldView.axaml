<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:TT_Lab.ViewModels.Editors"
             x:DataType="viewmodels:ActivatedShadersFieldViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
             x:Class="TT_Lab.Views.Editors.ActivatedShadersFieldView">
    <ItemsControl x:Name="TypesContainer">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="viewmodels:ShaderTypeItem">
                <UniformGrid Columns="2" Background="Transparent" ToolTip.Tip="{Binding Hint}" ToolTip.ShowDelay="500">
                    <TextBlock Text="{Binding Name}"/>
                    <CheckBox IsChecked="{Binding IsUsed, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/>
                </UniformGrid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
