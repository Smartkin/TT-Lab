<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:util="clr-namespace:TT_Lab.Util"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TT_Lab.Views.Editors.ChoiceFieldView">
    <ComboBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="Choices">
        <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="util:NamedChoice">
                <TextBlock ToolTip.Tip="{Binding Description}">
                    <Run Text="{Binding Value}" FontWeight="SemiBold"/>
                    <Run Text="{Binding Name}"/>
                </TextBlock>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
