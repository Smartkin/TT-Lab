<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TT_Lab.Controls"
        xmlns:viewModels="clr-namespace:TT_Lab.ViewModels"
        x:DataType="viewModels:PreferencesViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TT_Lab.Views.PreferencesView"
        Title="Preferences" Height="640" Width="460" WindowStartupLocation="CenterScreen">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="5" Spacing="5">
            <!-- Collapsible, settings.json keeps the collapsed ones by their titles -->
            <Border BorderBrush="DimGray" BorderThickness="1">
                <Expander x:Name="GeneralSection" ContentTransition="{x:Null}" IsExpanded="{Binding IsGeneralExpanded}" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="General" Padding="5"/>
                    </Expander.Header>
                    <StackPanel>
                        <controls:LabeledCheckBox Checked="{Binding AreEasterEggsEnabled}" LayoutOrientation="Horizontal" VerticalAlignment="Top" CheckBoxName="Enable Easter Eggs"/>
                        <Grid Margin="5" ColumnDefinitions="Auto,2*,30">
                            <Label VerticalAlignment="Center" Grid.Column="0" Content="Projects path"/>
                            <TextBox Grid.Column="1" Margin="5, 0, 0, 0" HorizontalAlignment="Stretch" Watermark="Projects path..." Height="30" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding ProjectsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                            <Button Command="{Binding SetProjectsPathCommand}" Grid.Column="2" Content="..."/>
                        </Grid>
                        <Grid Margin="5" ColumnDefinitions="Auto,2*,30">
                            <Label VerticalAlignment="Center" Grid.Column="0" Content="PS2 Disc Content path"/>
                            <TextBox Grid.Column="1" Margin="5, 0, 0, 0" HorizontalAlignment="Stretch" Watermark="PS2 unpacked ISO contents path..." Height="30" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding Ps2ContentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                            <Button Command="{Binding SetPs2DiscContentPathCommand}" Grid.Column="2" Content="..."/>
                        </Grid>
                        <Grid Margin="5" ColumnDefinitions="Auto,2*,30">
                            <Label VerticalAlignment="Center" Grid.Column="0" Content="Xbox Disc Content path"/>
                            <TextBox Grid.Column="1" Margin="5, 0, 0, 0" HorizontalAlignment="Stretch" Watermark="Xbox unpacked ISO contents path..." Height="30" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding XboxContentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                            <Button Command="{Binding SetXboxDiscContentPathCommand}" Grid.Column="2" Content="..."/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>
            <Border BorderBrush="DimGray" BorderThickness="1">
                <Expander x:Name="DirectGameLaunchSection" ContentTransition="{x:Null}" IsExpanded="{Binding IsDirectGameLaunchExpanded}" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Direct Game Launch" Padding="5"/>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Margin="5" TextWrapping="Wrap" Opacity="0.8"
                                   Text="The Play button of a chunk's scene plays it in PCSX2 2.0.0 or newer, in a window of its own (the PS2 version's PAL 1.01, NTSC 1.00 and NTSC 2.00 releases). Saving while it plays reloads the chunks in the game."/>
                        <Grid Margin="5" ColumnDefinitions="Auto,2*,30,30">
                            <Label VerticalAlignment="Center" Grid.Column="0" Content="PCSX2"/>
                            <TextBox x:Name="Pcsx2Path" Grid.Column="1" Margin="5, 0, 0, 0" HorizontalAlignment="Stretch" Watermark="{Binding FoundPcsx2}" Height="30" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding Pcsx2Path}" IsReadOnly="True"/>
                            <Button Command="{Binding ChoosePcsx2}" Grid.Column="2" Content="..." ToolTip.Tip="Pick PCSX2's executable"/>
                            <Button Command="{Binding ForgetPcsx2}" Grid.Column="3" Content="×" ToolTip.Tip="Find PCSX2 on its own: its Flatpak on Linux, its install in Program Files on Windows, or pcsx2-qt on the path"/>
                        </Grid>
                        <Grid Margin="5" ColumnDefinitions="Auto,2*,30,30">
                            <Label VerticalAlignment="Center" Grid.Column="0" Content="Disc image"/>
                            <TextBox x:Name="Pcsx2DiscImage" Grid.Column="1" Margin="5, 0, 0, 0" HorizontalAlignment="Stretch" Watermark="The project's built ISO (build/image)" Height="30" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding Pcsx2DiscImage}" IsReadOnly="True"/>
                            <Button Command="{Binding ChooseDiscImage}" Grid.Column="2" Content="..." ToolTip.Tip="Pick a disc image of the game, it plays its videos from it (the chunks come from the project whatever release the image is)"/>
                            <Button Command="{Binding ForgetDiscImage}" Grid.Column="3" Content="×" ToolTip.Tip="Use the project's built ISO"/>
                        </Grid>
                        <Grid Margin="5" ColumnDefinitions="Auto,2*">
                            <Label VerticalAlignment="Center" Grid.Column="0" Content="Additional arguments"/>
                            <TextBox x:Name="Pcsx2Arguments" Grid.Column="1" Margin="5, 0, 0, 0" HorizontalAlignment="Stretch" Watermark="Passed to PCSX2 with TT Lab's own" Height="30" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding Pcsx2Arguments}"
                                     ToolTip.Tip="Arguments PCSX2 gets after TT Lab's own (-nogui -fastboot -elf), before the disc image. Spaces separate them, quotes keep spaces in one. With -portable PCSX2 keeps its settings next to itself, where TT Lab puts the game's then"/>
                        </Grid>
                        <controls:LabeledCheckBox x:Name="ReloadGameAfterSaving" Checked="{Binding ReloadGameAfterSaving}" LayoutOrientation="Horizontal" VerticalAlignment="Top" CheckBoxName="Reload the game after saving"/>
                    </StackPanel>
                </Expander>
            </Border>
            <Border BorderBrush="DimGray" BorderThickness="1">
                <Expander x:Name="BlenderSection" ContentTransition="{x:Null}" IsExpanded="{Binding IsBlenderExpanded}" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Blender" Padding="5"/>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Margin="5" TextWrapping="Wrap" Opacity="0.8"
                                   Text="Edit in Blender opens TT Lab's models in Blender 4.5 or newer with the add-on TT Lab comes with. While TT Lab has their project open, what Blender changes of their materials and pictures shows in TT Lab at once and saving the blend file saves the models."/>
                        <Grid Margin="5" ColumnDefinitions="Auto,2*,30,30">
                            <Label VerticalAlignment="Center" Grid.Column="0" Content="Blender"/>
                            <TextBox x:Name="BlenderPath" Grid.Column="1" Margin="5, 0, 0, 0" HorizontalAlignment="Stretch" Watermark="{Binding FoundBlender}" Height="30" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding BlenderPath}" IsReadOnly="True"/>
                            <Button Command="{Binding ChooseBlender}" Grid.Column="2" Content="..." ToolTip.Tip="Pick Blender's executable"/>
                            <Button Command="{Binding ForgetBlender}" Grid.Column="3" Content="×" ToolTip.Tip="Find Blender on its own: on the path, its Flatpak, Steam's or its install in Program Files"/>
                        </Grid>
                        <StackPanel Margin="5" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="InstallBlenderAddon" Command="{Binding InstallBlenderAddon}" Content="Install the add-on"
                                    ToolTip.Tip="Installs the add-on TT Lab comes with into the Blender, enabled, and turns TT Lab 1.0.0's add-on off"/>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding BlenderAddon}"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
            <Border BorderBrush="DimGray" BorderThickness="1">
                <Expander x:Name="DiscordSection" ContentTransition="{x:Null}" IsExpanded="{Binding IsDiscordExpanded}" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Discord Rich Presence" Padding="5"/>
                    </Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:LabeledCheckBox x:Name="DiscordEnabled" Checked="{Binding DiscordEnabled}" LayoutOrientation="Horizontal" VerticalAlignment="Center" CheckBoxName="Enabled"/>
                        <Ellipse x:Name="DiscordStatus" Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding DiscordStatus}"/>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
