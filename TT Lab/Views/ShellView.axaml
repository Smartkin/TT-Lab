        xmlns:cal="http://caliburnmicro.com"
        xmlns:controls1="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
        mc:Ignorable="d"
        x:Class="TT_Lab.Views.ShellView"
        x:DataType="viewmodels:ShellViewModel"
        cal:Bind.AtDesignTime="True"
        Title="{Binding WindowTitle}" Height="720" Width="1280" MinWidth="854" MinHeight="480">
    
