<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TT_Lab.ViewModels"
             xmlns:controls="clr-namespace:TT_Lab.Controls"
             xmlns:editors="clr-namespace:TT_Lab.ViewModels.Editors"
             x:DataType="viewModels:ChunkInspectorViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             Focusable="True"
             x:Class="TT_Lab.Views.ChunkInspectorView">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S"/>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z"/>
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Y"/>
        <KeyBinding Command="{Binding RedoCommand}" Gesture="Ctrl+Shift+Z"/>
        <KeyBinding Command="{Binding Document?.InspectBackCommand}" Gesture="Alt+Left"/>
        <KeyBinding Command="{Binding Document?.InspectForwardCommand}" Gesture="Alt+Right"/>
    </UserControl.KeyBindings>
    <UserControl.Styles>
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.crumb.current">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <!-- Following a link in the inspector is a step along a trail: back, forward, the steps, and the shared asset a chunk's version is of -->
        <Border x:Name="Navigation" DockPanel.Dock="Top" Padding="2,2,2,3" BorderThickness="0,0,0,1" BorderBrush="#40808080"
                IsVisible="{Binding Inspected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="◀" Command="{Binding Document?.InspectBackCommand}" Margin="0,0,2,0" Padding="6,1"
                        ToolTip.Tip="Back to what the inspector showed before following a link (Alt+Left, the mouse's back button)"/>
                <Button DockPanel.Dock="Left" Content="▶" Command="{Binding Document?.InspectForwardCommand}" Margin="0,0,6,0" Padding="6,1"
                        ToolTip.Tip="Forward again (Alt+Right, the mouse's forward button)"/>
                <Button DockPanel.Dock="Right" Content="Open the shared asset" Command="{Binding Document?.OpenSharedAssetCommand}" Margin="6,0,0,0" Padding="6,1"
                        IsVisible="{Binding Document?.InspectedSharedAsset, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="This is the chunk's version of an asset other chunks share (blue values are the chunk's own). The asset's own tab edits the asset itself, for every chunk"/>
                <ItemsControl x:Name="Crumbs" ItemsSource="{Binding Document?.InspectorCrumbs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="editors:InspectorCrumb">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="›" VerticalAlignment="Center" Margin="2,0" Opacity="0.6" IsVisible="{Binding HasSeparator}"/>
                                <Button Classes="crumb" Classes.current="{Binding IsCurrent}" Content="{Binding Caption}" ToolTip.Tip="{Binding Hint}" Click="CrumbClicked"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <Grid>
            <TextBlock Text="Select something in a chunk's scene or open one of its resources to inspect it" TextWrapping="Wrap" Margin="10" Opacity="0.7"
                       IsVisible="{Binding Inspected, Converter={x:Static ObjectConverters.IsNull}}"/>
            <!-- The document's own scroll viewer and inspector view, kept while its tab is open -->
            <Decorator x:Name="InspectorHost" IsVisible="{Binding Inspected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </Grid>
    </DockPanel>
</UserControl>
